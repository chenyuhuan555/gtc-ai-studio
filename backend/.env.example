# ===== 数据库 =====
# 本地开发默认 SQLite，无需任何外部依赖即可跑通。
# 接入 Supabase 时，把下面这行换成 Supabase 的 Pooler/Transaction 连接串即可：
#   postgresql://postgres:[密码]@db.[项目ref].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./gtc.db

# ===== DeepSeek（提示词优化）=====
# 留空则后端自动使用「规则化生成引擎」，无需 Key 也能产出品牌一致的文案与 Prompt。
# 填入后，Prompt 优化引擎与内容生成的图片 Prompt 会改为调用 DeepSeek 优化
#（生成的提示词由你复制到网页 ChatGPT / Midjourney 使用，不接 OpenAI）。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ===== CORS =====
# 开发时前端运行在 5173，生产按需修改。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 工作区同步 =====
# 生产环境必须填写 Supabase Auth 使用的 JWT Secret；不要提交真实值。
SUPABASE_JWT_SECRET=
# Supabase 项目 URL，用于验证新版 JWT Signing Keys。
SUPABASE_URL=
# Supabase anon public key，仅用于向 Auth 确认 Token；不要填 service_role。
SUPABASE_ANON_KEY=
# 可选：逗号分隔的 Supabase Auth 用户 UUID；填写后只有这些账号可访问 GTC 数据。
GTCA_ALLOWED_USER_IDS=
# 仅本地临时调试时可设为 true；生产环境必须保持 false。
SYNC_AUTH_DISABLED=false
